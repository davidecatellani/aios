#!/bin/sh
# Avviato da greetd come utente «greeter»: la schermata d'accesso di AIOS a tutto schermo (cage).
# Se non parte, l'accesso testuale di greetd: non si resta mai chiusi fuori.
export HOME=/tmp/aios-accesso XDG_CACHE_HOME=/tmp/aios-accesso/cache XDG_DATA_HOME=/tmp/aios-accesso/dati
export XDG_CONFIG_HOME=/tmp/aios-accesso/config GTK_THEME=Adwaita:dark
mkdir -p "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
if command -v cage >/dev/null && command -v aios-accesso >/dev/null; then
  cage -s -d -- aios-accesso && exit 0
fi
exec agreety --cmd /usr/bin/aios-sessione
