#!/bin/sh
# Zoom attorno al puntatore (Impostazioni › Accessibilità): aios-zoom + | - | 0
cur=$(hyprctl getoption cursor:zoom_factor 2>/dev/null | sed -n 's/^ *float: *//p')
[ -n "$cur" ] || cur=1
case "$1" in
  +) new=$(awk -v c="$cur" 'BEGIN { n = c * 1.25; if (n > 6) n = 6; printf "%.2f", n }') ;;
  -) new=$(awk -v c="$cur" 'BEGIN { n = c * 0.8; if (n < 1) n = 1; printf "%.2f", n }') ;;
  *) new=1 ;;
esac
hyprctl keyword cursor:zoom_factor "$new" >/dev/null
