#!/usr/lib/aios/laya/bin/python3
"""aios-decisore: Laya, il System One di Nova, su 127.0.0.1:11437 (API System One, come laya-serve).

POST /v1/systemone {"state": testo, "questions": {...}} → {"answers": {...}}; GET /health.
Un solo modello (/usr/share/aios/laya, addestrato per Nova), sempre caricato: ricaricarlo costa decine di
secondi, una decisione costa ~0,2 s. Due thread di calcolo: l'interfaccia e il modello di conversazione
restano liberi.
"""

import json
import os
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

os.environ.setdefault("HF_HUB_OFFLINE", "1")
os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
MODEL = os.environ.get("AIOS_LAYA", "/usr/share/aios/laya")
PORT = int(os.environ.get("AIOS_DECISORE_PORT", "11437"))
MAX_BODY = 256 * 1024

import torch  # noqa: E402

torch.set_num_threads(int(os.environ.get("AIOS_DECISORE_THREADS", "2")))
import laya  # noqa: E402

agent = laya.load(MODEL, device="cpu")
lock = threading.Lock()
with lock:  # la prima decisione prepara tutto: quelle vere arrivano già veloci
    agent.predict("ciao", {"x": {"type": "choice", "instructions": "?", "criteria": {"a": "a", "b": "b"}}})


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body):
        data = json.dumps(body, ensure_ascii=False, default=float).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self._send(200, {"status": "ok", "model": "nova"} if self.path == "/health" else {"error": "not found"})

    def do_POST(self):
        if self.path != "/v1/systemone":
            return self._send(404, {"error": "not found"})
        size = int(self.headers.get("Content-Length") or 0)
        if size <= 0 or size > MAX_BODY:
            return self._send(413, {"error": "body too large"})
        try:
            body = json.loads(self.rfile.read(size))
            state, questions = body.get("state") or "", body["questions"]
            with lock:
                result = agent.predict(state, questions)
            self._send(200, {"answers": result["answers"]})
        except (ValueError, KeyError, TypeError) as exc:
            self._send(400, {"error": str(exc)[:300]})
        except Exception as exc:  # il servizio resta su anche se una domanda è strana
            self._send(500, {"error": str(exc)[:300]})

    def log_message(self, *args):
        pass


print(f"aios-decisore: Laya da {MODEL} su 127.0.0.1:{PORT}", file=sys.stderr, flush=True)
ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
