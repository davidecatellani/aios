[Unit]
Description=Ollama: modelli AI locali di SoIA
After=network-online.target

[Service]
User=ollama
Group=ollama
StateDirectory=ollama
Environment=HOME=/var/lib/ollama
Environment=OLLAMA_MODELS=/var/lib/ollama/models
# memoria della conversazione del modello compressa (memory.py)
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
# i modelli già inclusi nell'immagine (/usr/share/aios/modelli)
ExecStartPre=-/usr/libexec/aios-modelli-inclusi
ExecStart=/usr/bin/ollama serve
# una richiesta alla volta; in memoria il 4B di Nova (circa 3,4 GB) più Tev1 o embeddinggemma se servono
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=3
Restart=on-failure
# l'interfaccia viene prima: anche quando Nova pensa, clic e tastiera restano pronti
Nice=10
CPUWeight=40
IOWeight=40

[Install]
WantedBy=multi-user.target
