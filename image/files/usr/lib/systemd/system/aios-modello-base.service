[Unit]
Description=AIOS: scarica il modello AI di base di Nova appena c'è internet
After=ollama.service network-online.target
Wants=ollama.service network-online.target

[Service]
Type=oneshot
# già scaricato: niente da fare
ExecCondition=/bin/sh -c '! /usr/bin/ollama list 2>/dev/null | grep -q "^qwen2.5:1.5b-instruct"'
ExecStart=/usr/bin/ollama pull qwen2.5:1.5b-instruct
Restart=on-failure
RestartSec=120
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
