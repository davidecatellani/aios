[Unit]
Description=AIOS: scarica il modello AI di base di Nova se manca (di solito è già incluso)
After=ollama.service
Wants=ollama.service

[Service]
# «simple» e un ciclo, non «oneshot» con nuovi tentativi: senza internet non deve tenere il
# sistema «in avvio» (greenboot lo prenderebbe per un guasto e riavvierebbe il PC).
Type=simple
ExecStart=/bin/sh -c 'until /usr/bin/ollama list 2>/dev/null | grep -q "^qwen3.5:4b" || /usr/bin/ollama pull qwen3.5:4b; do sleep 300; done'
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
