#!/bin/sh
# Blocca lo schermo con l'aspetto di AIOS: ora, data e un vero campo password (gtklock).
# Senza gtklock, swaylock (solo il cerchio) come riserva.
if command -v gtklock >/dev/null; then
  exec gtklock -d -s /usr/share/aios/gtklock/style.css "$@"
fi
exec swaylock -f -C /usr/share/aios/swaylock/config "$@"
