#!/bin/sh
# La sessione di AIOS: il compositore Hyprland (solo schermo, input e animazioni, niente interfaccia
# sua) con la shell di AIOS sopra. Configurazione in /usr/share/aios/hyprland; l'utente può
# aggiungere righe sue in ~/.config/aios/hyprland.conf. Se Hyprland manca (o con
# AIOS_COMPOSITORE=labwc) si usa labwc, configurato in /usr/share/aios/labwc.
export XDG_CURRENT_DESKTOP=AIOS
export XDG_SESSION_DESKTOP=aios
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export _JAVA_AWT_WM_NONREPARENTING=1
export GTK_THEME=Adwaita:dark
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
# tastiera: quella scelta dall'utente (Impostazioni › Tastiera), altrimenti quella dell'installazione
layout=$(cat "$config_home/aios/tastiera" 2>/dev/null)
[ -n "$layout" ] || layout=$(localectl status 2>/dev/null | sed -n 's/.*X11 Layout: *//p' | head -n1)
export XKB_DEFAULT_LAYOUT="${layout:-it}"

if [ "${AIOS_COMPOSITORE:-hyprland}" != labwc ] && command -v Hyprland >/dev/null; then
  run="${XDG_RUNTIME_DIR:-/tmp}/aios-hyprland"
  mkdir -p "$run"
  printf 'input {\n    kb_layout = %s\n}\n' "$XKB_DEFAULT_LAYOUT" > "$run/tastiera.conf"
  cp -f "$config_home/aios/hyprland.conf" "$run/utente.conf" 2>/dev/null || : > "$run/utente.conf"
  sed "s#@RUN@#$run#g" /usr/share/aios/hyprland/hyprland.conf > "$run/hyprland.conf"
  exec Hyprland --config "$run/hyprland.conf"
fi

config=/usr/share/aios/labwc
[ -f "$config_home/labwc/rc.xml" ] && config="$config_home/labwc"
# copia di lavoro: la tastiera si cambia riscrivendo environment e con «labwc --reconfigure»
run="${XDG_RUNTIME_DIR:-/tmp}/aios-labwc"
mkdir -p "$run" && cp -f "$config"/* "$run"/ 2>/dev/null
grep -v '^XKB_DEFAULT_LAYOUT=' "$config/environment" 2>/dev/null > "$run/environment"
echo "XKB_DEFAULT_LAYOUT=$XKB_DEFAULT_LAYOUT" >> "$run/environment"
exec labwc -C "$run"
