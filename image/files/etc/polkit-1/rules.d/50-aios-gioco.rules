// AIOS: quando parte un gioco la shell ferma il nucleo di Nova (aios-nucleo) per liberare memoria e lo
// riavvia alla fine (giochi.py). Solo quel servizio, solo per l'amministratore seduto al computer.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "aios-nucleo.service" &&
        (action.lookup("verb") === "start" || action.lookup("verb") === "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
