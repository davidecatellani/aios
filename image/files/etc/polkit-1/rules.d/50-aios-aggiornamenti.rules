// SoIA: gli aggiornamenti del sistema (rpm-ostree e bootc) e delle app di sistema (Flatpak) li prepara Nova per l'utente amministratore
// seduto al computer, senza finestre di password: in SoIA non ci sono finestre di sistema. Gli altri
// utenti e gli accessi da remoto restano soggetti alle regole normali.
polkit.addRule(function (action, subject) {
    var flatpak = ["org.freedesktop.Flatpak.app-update", "org.freedesktop.Flatpak.runtime-update",
                   "org.freedesktop.Flatpak.appstream-update", "org.freedesktop.Flatpak.metadata-update"];
    if ((action.id.indexOf("org.projectatomic.rpmostree1.") === 0 || action.id.indexOf("org.containers.bootc.") === 0 ||
         flatpak.indexOf(action.id) >= 0) &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
