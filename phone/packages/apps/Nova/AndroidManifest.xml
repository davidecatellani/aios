<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.aios.nova">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
    <!-- Collegamento con il PC anche senza Wi-Fi (nearby/): Bluetooth a basso consumo, rete diretta, condivisione -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.OVERRIDE_WIFI_CONFIG" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />

    <application
        android:name=".NovaApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/nova"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity android:name=".NovaActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".setup.RestoreActivity" android:exported="false" />
        <activity android:name=".setup.PrototypeActivity" android:exported="false" />
        <activity android:name=".pc.PcFilesActivity" android:exported="false" />
        <service android:name=".assistant.WakeService" android:exported="false" android:foregroundServiceType="microphone" />
        <receiver android:name=".core.ReminderReceiver" android:exported="false" />

        <!-- Nova come assistente di sistema (pressione lunga del tasto di accensione) -->
        <service android:name=".assistant.NovaInteractionService" android:exported="true"
                 android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/nova_interaction_service" />
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
        </service>
        <service android:name=".assistant.NovaSessionService" android:exported="true"
                 android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".assistant.NovaRecognitionService" android:exported="true" android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>

        <!-- Lavoro in sottofondo solo tramite JobScheduler, con i vincoli di energia -->
        <service android:name=".energy.EnergyJobService" android:exported="false"
                 android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Vicini: la ricerca BLE sveglia Nova solo per i codici SoIA; il servizio vive solo col PC vicino -->
        <receiver android:name=".nearby.NearbyReceiver" android:exported="false" />
        <service android:name=".nearby.NearbyService" android:exported="false"
                 android:foregroundServiceType="connectedDevice" />

        <receiver android:name=".energy.BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
